# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.coverage

# Data / logs / secrets
data/**/*.db
logs/*.log*
# modules/plugin_agent/plugin_loader.py seeds this from modules/plugins/ on
# every startup (a packaged build's modules/plugins/ is read-only, so
# approved/pending plugins live here instead) — pure runtime state, the
# source of truth is modules/plugins/.
data/plugins/
data/voices/*.onnx
data/voices/*.onnx.json
# Silero TTS checkpoint — user downloads this manually per
# core/voice/silero_tts.py, it isn't shipped in the repo.
data/voices/*.pt
# MediaPipe HandLandmarker weights — fetched on first use by
# modules/gesture_control/hand_tracker.py, same as the Silero checkpoint.
data/models/
# Playwright's persistent browser contexts (modules/ai_bridge) — contains
# logged-in session cookies for Gemini/ChatGPT/DeepSeek/Grok, must never be committed.
data/browser_profiles/
# faster-whisper's Hugging Face model cache (see Dockerfile's HF_HOME)
data/.cache/
# Auto-generated shared secret for /api/* requests — see core/config.py's
# _load_or_create_api_token.
data/api_token.txt
# AI-generated images (modules/image_generation) — user content, not source.
data/generated_images/
# Rolling transcript of user/assistant turns (modules/conversation_log) —
# per-machine conversation history, not source.
data/conversation_log.jsonl

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/dist-electron/
frontend/dist-builder/
frontend/release/

# figma_plugin — code.js is a build artifact (npm run build); see that
# directory's README.md. Not shipped in the repo since Figma reloads it
# fresh from source each time anyway.
figma_plugin/node_modules/
figma_plugin/code.js

# Editors / OS
.idea/
.vscode/
.DS_Store

# Local Claude Code settings — machine-specific, not for the repo.
.claude/

# Claude Code's private working notes for itself between sessions — never
# for GitHub, re-read this at the start of a new session if context is lost.
AGENT_NOTES.md

# Claude Code's project-instructions file — local guidance only, not for the
# repo. Purged from history 2026-09-02.
CLAUDE.md
