{
  "name": "assistant-frontend",
  "version": "0.3.0",
  "private": true,
  "description": "Electron + React tray UI for the local assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:docker": "ASSISTANT_EXTERNAL_BACKEND=1 concurrently -k \"npm:dev:vite\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:vite && npm run build:electron",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
