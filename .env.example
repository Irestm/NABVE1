# Скопируйте в .env и поправьте при необходимости: cp .env.example .env
# UID/GID пользователя в контейнере — должны совпадать с `id -u` / `id -g`,
# чтобы файлы в ./data и ./logs оставались вашими.
UID=1000
GID=1000

# Порт веб-интерфейса и API.
ASSISTANT_PORT=8756

# Колёса PyTorch: CPU по умолчанию (для Silero TTS достаточно).
# Для CUDA-сборки: https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Фиксированный токен API (иначе генерируется в data/api_token.txt).
# ASSISTANT_API_TOKEN=
